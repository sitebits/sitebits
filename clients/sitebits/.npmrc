# Lieferkettenregeln
# Nur Pakete, die mindestens 7 Tage öffentlich sind.
min-release-age=7
# Install-Skripte von Abhängigkeiten nie ausführen (esbuild läuft über den JS-Shim).
ignore-scripts=true
# Keine git- oder Tarball-URL-Abhängigkeiten.
allow-git=none
allow-remote=none
# Neue Abhängigkeiten exakt eintragen.
save-exact=true
audit-level=high
engine-strict=true
