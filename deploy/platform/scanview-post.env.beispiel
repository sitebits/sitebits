# /etc/scanview/scanview-post.env — Umgebung für scanview-post (E-Mail-Benachrichtigung, F8).
# root:scanview-post, 0640. Das SMTP-Passwort steht NICHT hier, sondern in einer eigenen Datei
# (SCANVIEW_SMTP_PASSWORT_DATEI, Rechte 0600, Eigentümer scanview-post); der Dienst startet
# nicht, wenn sie für Gruppe oder andere lesbar ist.
#
# Herstellerneutral: jeder SMTP-Dienst mit Anmeldung. Welcher, entscheidet der Betreiber
# (Auftragsverarbeitung prüfen). Absenderdomain mit SPF, DKIM und DMARC einrichten.

# Spool-Verzeichnis, gleich wie SCANVIEW_POST in scanview-server.env
SCANVIEW_POST=/srv/scanview/post
SCANVIEW_SMTP_HOST=smtp.example.org
# tls = implizites TLS (Port 465, Standard) | starttls (Port 587) | keine (nur zu localhost)
SCANVIEW_SMTP_SICHERHEIT=tls
#SCANVIEW_SMTP_PORT=465
SCANVIEW_SMTP_BENUTZER=benachrichtigung@example.org
SCANVIEW_SMTP_PASSWORT_DATEI=/etc/scanview/scanview-post.passwort
# Envelope-Absender, gleich wie SCANVIEW_POST_ABSENDER in scanview-server.env
SCANVIEW_POST_ABSENDER=benachrichtigung@example.org
# Höchstens so viele Zustellversuche je Minute (1 bis 600)
SCANVIEW_POST_PRO_MINUTE=30
