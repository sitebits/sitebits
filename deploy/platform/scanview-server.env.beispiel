# /etc/scanview/scanview-server.env — Umgebung für scanview-server (EnvironmentFile der Unit).
# Wird von einrichten.sh nur angelegt, wenn die Datei fehlt (root:scanview, 0640).
# Enthält keine Geheimnisse; Sitzungs- und Einladungstokens liegen gehasht in der Datenbank.

# Paketwurzel (nur lesend): /srv/scanview/data/<projectId>/project.json (Schema 2)
SCANVIEW_DATA=/srv/scanview/data
# SQLite-Datenbank scanview.db (nur für den Dienstnutzer beschreibbar)
SCANVIEW_STATE=/srv/scanview/state
# Öffentliche Origin ohne Slash am Ende — muss exakt zum Origin-Header des Browsers passen
# (CSRF-Prüfung) und steht in Einladungslinks.
SCANVIEW_ORIGIN=https://scanview.example.org
# WebAuthn Relying-Party-ID = Hostname der Origin (ohne Schema/Port). Nie nachträglich ändern:
# alle registrierten Passkeys hängen an dieser ID.
SCANVIEW_RP_ID=scanview.example.org
# Anzeigename im Passkey-Dialog des Browsers
SCANVIEW_RP_NAME=scanview
# 1 = Cookie mit Secure (Pflicht für __Host-). Nur für Tests ohne HTTPS auf 0 setzen.
SCANVIEW_COOKIE_SECURE=1
# Protokollstufe fürs Journal („Erweitert“ → Debug-Modus): DEBUG|INFO|WARNING, ein
# unbekannter Wert fällt mit einer Warnung auf INFO zurück. DEBUG protokolliert je
# /api/authz-Aufruf eine Zeile (Status, Projekt-ID, Dauer) — nie Cookie, Token, E-Mail oder IP.
# Ausnahme Sicherheitslog: fehlgeschlagene Passwort-Anmeldungen (WARNING) tragen die Client-IP
# für das fail2ban-Jail (deploy/platform/fail2ban/), nie die E-Mail.
SCANVIEW_LOG_LEVEL=INFO
# Globale Anmeldebremse: ab so vielen fehlgeschlagenen Passwort-Anmeldungen je Minute (alle Konten
# zusammen) bekommt jede Passwort-Anmeldung 429, bis die Minute weitergerückt ist. Ganze Zahl ≥ 1,
# Standard 30. Passkey-Anmeldung und bestehende Sitzungen sind nicht betroffen.
SCANVIEW_ANMELDE_FEHLER_PRO_MINUTE=30
# Lesezugriffsprotokoll (wer hat wann welches Projekt gelesen; personenbezogen, nur für Admins
# einsehbar): Aufbewahrung in Tagen, Standard 90, erlaubt 7 bis 730; 0 = aus (nichts wird erfasst,
# vorhandene Einträge werden beim Start gelöscht). Datenschutz: docs/public/betrieb.md.
#SCANVIEW_LESEZUGRIFFE_TAGE=90
# Quelltext-Link (EUPL-1.2) in der Fußzeile des Portals: https-Adresse des öffentlichen
# Quelltexts dieser Version. Leer oder auskommentiert = kein Link. Nur https://, sonst startet der
# Dienst nicht. Die Instanz muss den Quelltext für ihre Nutzer erreichbar anbieten (EUPL-1.2, Art. 5).
#SCANVIEW_QUELLTEXT_URL=https://quelltext.example.org/scanview

# Barrierefreiheit: Ziel des Links „Barriere melden“ (mailto:<adresse> oder https://…) und Pfad zur
# ausgefüllten Erklärung. Fehlt eine der beiden, warnt der Dienst beim Start und `einrichten.sh` schreibt eine
# Warnung ins Update-Protokoll. Einzelheiten: docs/public/barrierefreiheit.md.
#SCANVIEW_BARRIEREFREIHEIT_KONTAKT=mailto:barrierefreiheit@example.org
#SCANVIEW_BARRIEREFREIHEIT_ERKLAERUNG=/etc/scanview/barrierefreiheit.toml

# Impressum und Datenschutzhinweise: Ziel der Links in der Fußzeile des Portals (auch auf der
# Anmeldeseite). Den Rechtstext stellt der Betreiber, scanview liefert keinen. Erlaubt ist eine
# https://-Adresse ohne Zugangsdaten oder ein Pfad auf derselben Origin (/…, nicht //…), den die
# Instanz selbst ausliefert; sonst startet der Dienst nicht. Fehlt einer, warnt der Dienst beim
# Start und `einrichten.sh` schreibt eine Warnung ins Update-Protokoll. Die Datenschutzhinweise
# müssen auch den lokalen Befundentwurf im Browser (IndexedDB) nennen. Einzelheiten:
# docs/public/betrieb.md.
#SCANVIEW_IMPRESSUM_URL=https://stelle.example.org/impressum
#SCANVIEW_DATENSCHUTZ_URL=https://stelle.example.org/datenschutz/scanview

# Git-Export der Bearbeitungen (ab Werk aus): 1 = scanview-git-export.timer exportiert alle
# 5 min neue Bearbeitungen je Projekt als Commits (einrichten.sh erneut laufen lassen, damit der
# Timer an- bzw. ausgeht). Autoren pseudonym „Nutzer <id>“, Klarname nur mit Einwilligung im Konto.
SCANVIEW_GIT_EXPORT=0
# Ablage der Repos (Standard: $SCANVIEW_STATE/git) — muss unter /srv/scanview/state liegen, sonst
# darf die gehärtete Unit dort nicht schreiben.
#SCANVIEW_GIT_DIR=/srv/scanview/state/git
# Push-Ziel je Projekt, Pflicht-Platzhalter {projekt}. Leer = kein Push. Braucht das Netz-Drop-in
# aus docs/public/betrieb.md („Git-Export der Bearbeitungen“). Keine Zugangsdaten in die URL schreiben — Anmeldung per
# SSH-Schlüssel des Dienstes (Datei, chmod 600, nie im Repo), siehe GIT_SSH_COMMAND.
#SCANVIEW_GIT_REMOTE=ssh://git@forgejo.example/scanview/{projekt}.git
# ssh sucht Schlüssel im passwd-Heimatverzeichnis (/nonexistent) — darum ausdrücklich angeben.
# In Anführungszeichen: die Datei wird auch per `. datei` in bash geladen (sv-Funktion, docs/public/betrieb.md).
#GIT_SSH_COMMAND="ssh -i /srv/scanview/state/git-ssh/id_ed25519 -o IdentitiesOnly=yes -o UserKnownHostsFile=/srv/scanview/state/git-ssh/known_hosts -o StrictHostKeyChecking=yes -o BatchMode=yes"
