# Lieferkettenregeln (wie web/.npmrc): Werkzeug-Lockfile der SBOM-Erzeugung (cyclonedx-npm).
# Nur Pakete, die mindestens 7 Tage öffentlich sind.
min-release-age=7
# Install-Skripte von Abhängigkeiten nie ausführen.
ignore-scripts=true
# Keine git- oder Tarball-URL-Abhängigkeiten.
allow-git=none
allow-remote=none
# Neue Abhängigkeiten exakt eintragen.
save-exact=true
audit-level=high
engine-strict=true
